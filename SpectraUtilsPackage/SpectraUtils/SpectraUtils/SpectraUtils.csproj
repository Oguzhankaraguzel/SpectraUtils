<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>

    <PackageId>SpectraUtils</PackageId>
    <Title>Spectra Utils</Title>
    <Product>Spectra Utils</Product>
    <Description>Dependency-free utilities for .NET: Turkish ID (TCKN), Turkish tax number (VKN) and IBAN validation, minimum age validation, Turkish-aware name formatting, PBKDF2 password hashing, secure token / OTP / password generation and handy LINQ &amp; string extensions. For IFormFile validation see SpectraUtils.AspNetCore.</Description>
    <PackageTags>validation;tckn;vkn;iban;turkish;password;pbkdf2;otp;token;name-formatting;security;dataannotations</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SpectraUtils.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="tools.png" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
