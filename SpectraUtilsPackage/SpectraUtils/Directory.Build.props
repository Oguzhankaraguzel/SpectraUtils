<Project>
  <!-- Shared settings for every project in this folder. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- Package metadata (only used by packable projects). -->
  <PropertyGroup>
    <Version>3.0.0</Version>
    <Authors>Oğuzhan KARAGÜZEL</Authors>
    <Company>Oğuzhan KARAGÜZEL</Company>
    <Copyright>Copyright (c) 2024-2026 Oğuzhan KARAGÜZEL</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Oguzhankaraguzel/SpectraUtils</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Oguzhankaraguzel/SpectraUtils</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>tools.png</PackageIcon>
    <PackageReleaseNotes>https://github.com/Oguzhankaraguzel/SpectraUtils/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <NeutralLanguage>en</NeutralLanguage>

    <!-- SourceLink (built into the .NET 8+ SDK) and symbol packages. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
